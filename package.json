{
  "name": "crud-api",
  "version": "1.0.0",
  "description": "Simple CRUD API",
  "engines": {
    "node": ">=24.10.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:dev": "nodemon",
    "start:prod": "webpack --config webpack.config.cjs && node dist/bundle.mjs",
    "start:multi": "npm run build && node build/multi",
    "lint": "eslint . --ext .ts,.cjs",
    "lint:fix": "eslint . --ext .ts,.cjs --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anika3160/simple-crud-api.git"
  },
  "keywords": [
    "nodejs",
    "js",
    "typescript"
  ],
  "author": "Anna Surahatava <anika3160@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anika3160/simple-crud-api/issues"
  },
  "homepage": "https://github.com/anika3160/simple-crud-api#readme",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/node": "^24.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "globals": "^15.12.0",
    "typescript-eslint": "^8.13.0",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "eslint-plugin-prettier": "^5.5.4"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "uuid": "^13.0.0"
  }
}
